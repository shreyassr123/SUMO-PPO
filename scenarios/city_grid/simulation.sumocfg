<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO configuration for the city-grid traffic-signal scenario.
     View it with:  sumo-gui -c scenarios/city_grid/simulation.sumocfg
     (every signal then runs its own fixed program from the network file).

     The settings follow the original Mobility_PPO simulation. The day starts
     at 06:30 (23400 s): the activity demand peaks between 06:00 and 09:00, and
     people whose trips start before 06:30 are skipped by SUMO. The
     environment then lets the traffic build up for a warm-up period before
     the agent takes over (see envs/__init__.py). -->
<configuration>
    <input>
        <net-file value="network.net.xml"/>
        <route-files value="buses.rou.xml,metro.rou.xml,activity_demand.rou.xml"/>
        <additional-files value="vehicle_types.add.xml,bus_stops.add.xml,metro_stops.add.xml,parking_areas.add.xml,parking_rerouters.add.xml"/>
    </input>
    <time>
        <begin value="23400"/>
        <step-length value="1"/>
    </time>
    <processing>
        <ignore-route-errors value="true"/>
        <lateral-resolution value="1.6"/>
        <ignore-junction-blocker value="60"/>
        <collision.action value="warn"/>
        <time-to-teleport value="300"/>
        <max-depart-delay value="900"/>
        <time-to-impatience value="30"/>
        <pedestrian.model value="striping"/>
        <pedestrian.striping.stripe-width value="0.55"/>
        <pedestrian.striping.jamtime value="30"/>
        <default.emergencydecel value="decel"/>
    </processing>
    <routing>
        <persontrip.transfer.car-walk value="parkingAreas,ptStops"/>
        <device.rerouting.probability value="1"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.pre-period value="300"/>
        <person-device.rerouting.probability value="1"/>
        <person-device.rerouting.period value="300"/>
        <device.rerouting.threads value="4"/>
    </routing>
</configuration>
